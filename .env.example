# Model-specific live integration test configuration only.
# See docs/env/README.md and each provider guide. Wickle core does not load this file.
# Provider adapters and model-specific live tests are not implemented yet.
# These variable names are test-harness conventions, not library runtime settings.
# Each numbered model slot is an independent model/version test case.
# Share credentials within a provider; use another .env file for another resource.
# Never commit the resulting .env.

# *_MODEL_<N>_ID is the provider ID; *_MODEL_<N>_VERSION is verified release metadata.
# Add _MODEL_2_ID / _MODEL_2_VERSION, _MODEL_3_..., and so on for more cases.
# Use a separate slot for each version. A blank model ID does not configure a case.
# Do not invent a version or assume an alias/deployment is immutable.
# Leave unknown versions blank for preparation; resolve them before pinned tests.

# OpenAI GPT
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL_1_ID=
OPENAI_MODEL_1_VERSION=
# Optional headers, only when needed for the selected key:
# OPENAI_ORG_ID=
# OPENAI_PROJECT_ID=

# Azure Foundry OpenAI GPT
# Resource origin only, e.g. https://<resource>.openai.azure.com
# The v1 request base appends /openai/v1/ to this origin.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_MODEL_1_ID=
AZURE_OPENAI_MODEL_1_VERSION=
AZURE_OPENAI_MODEL_1_DEPLOYMENT=
AZURE_OPENAI_API_MODE=v1
# Only dated API mode uses an api-version query parameter; leave empty for v1.
AZURE_OPENAI_API_VERSION=
# api_key or entra; choose exactly one authentication method.
AZURE_OPENAI_AUTH_MODE=api_key
AZURE_OPENAI_API_KEY=
# Entra mode: use Azure CLI/managed identity, or configure a service principal.
# AZURE_TENANT_ID=
# AZURE_CLIENT_ID=
# AZURE_CLIENT_SECRET=
# AZURE_OPENAI_ENTRA_SCOPE=https://ai.azure.com/.default

# Anthropic Claude (direct API)
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_API_VERSION=2023-06-01
ANTHROPIC_MODEL_1_ID=
ANTHROPIC_MODEL_1_VERSION=
# Required for an identity-linked key that is not scoped to one workspace:
# ANTHROPIC_WORKSPACE_ID=

# AWS Bedrock Claude, using the AWS SDK credential provider chain.
# Set the invocation/source region explicitly for a selected Bedrock test.
AWS_REGION=
BEDROCK_MODEL_1_ID=
BEDROCK_MODEL_1_VERSION=
# Optional routing target: inference profile ID or ARN; underlying model above.
# BEDROCK_MODEL_1_INFERENCE_PROFILE_ID=
# Optional endpoint override; otherwise the SDK resolves it from AWS_REGION.
# BEDROCK_ENDPOINT=
# Select a named profile, or leave unset for the default/cloud identity chain.
# AWS_PROFILE=
# Optional temporary credentials instead of a profile/cloud identity:
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=

# Google AI Studio / Gemini API (API-key authentication)
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com
GEMINI_API_VERSION=v1
GEMINI_MODEL_1_ID=
GEMINI_MODEL_1_VERSION=

# Google Cloud Vertex AI Gemini (Application Default Credentials)
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=
VERTEX_API_VERSION=v1
VERTEX_MODEL_1_ID=
VERTEX_MODEL_1_VERSION=
# Optional endpoint origin; normally derived from the chosen location.
# VERTEX_ENDPOINT=
# Only set for a specific credential/configuration file. Leave unset for local
# gcloud ADC or an attached cloud identity. Keep the file outside this repository.
# GOOGLE_APPLICATION_CREDENTIALS=
# Optional quota project override for ADC:
# GOOGLE_CLOUD_QUOTA_PROJECT=

# xAI Grok
XAI_API_KEY=
XAI_BASE_URL=https://api.x.ai/v1
XAI_MODEL_1_ID=
XAI_MODEL_1_VERSION=
